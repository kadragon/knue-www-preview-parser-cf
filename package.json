{
  "name": "knue-www-preview-parser-cf",
  "version": "1.0.0",
  "description": "Cloudflare Workers service to parse KNUE document previews to Markdown",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "cloudflare-workers",
    "puppeteer",
    "document-parser",
    "knue"
  ],
  "author": "kadragon",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.5",
    "basic-ftp": "^6.2.6",
    "zod": "^4.6.7"
  }
}
