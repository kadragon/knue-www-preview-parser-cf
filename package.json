{
  "name": "knue-www-preview-parser-cf",
  "version": "1.0.0",
  "description": "Cloudflare Workers service to parse KNUE document previews to Markdown",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "cloudflare-workers",
    "puppeteer",
    "document-parser",
    "knue"
  ],
  "author": "kadragon",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.11",
    "@cloudflare/workers-types": "^4.20241011.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.53.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.4"
  }
}
