{
  "name": "knue-www-preview-parser-cf",
  "version": "1.0.0",
  "description": "Cloudflare Workers service to parse KNUE document previews to Markdown",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "cloudflare-workers",
    "puppeteer",
    "document-parser",
    "knue"
  ],
  "author": "kadragon",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20260307.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.58.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0"
  }
}
